includes:
	- phar://phpstan.phar/conf/bleedingEdge.neon
	# Not registered by phpstan/extension-installer (see composer.json), so that the rules are not applied to the compiled templates in the tests.
	- vendor/shipmonk/phpstan-rules/rules.neon
rules:
	- TwigStan\PHPStan\Rules\ForbidSuppressingTagsRule
parameters:
	level: max
	paths:
		- bin/twigstan
		- src
		- tests
	tmpDir: .phpstan
	reportUnmatchedIgnoredErrors: false
	checkTooWideReturnTypesInProtectedAndPublicMethods: true
	checkBenevolentUnionTypes: true
	reportPossiblyNonexistentConstantArrayOffset: true
	treatPhpDocTypesAsCertain: false
	errorFormat: ticketswap
	editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
	excludePaths:
		- tests/PHPStan/Rules/data
	bootstrapFiles:
		- stubs/functions.php
	# The stubs are analysed as project stubs here, so PHPStan reports any errors in them.
	stubFiles:
		- stubs/Symfony/AppVariable.stub
		- stubs/Twig/CoreExtension.stub
		- stubs/Twig/Runtime/EscaperRuntime.stub
	ignoreErrors:
		# TwigStan analyzes compiled templates, so it relies on Twig internals by design.
		-
			identifier: classConstant.internalClass
			message: '#internal class Twig\\#'
		-
			identifier: method.internal
			message: '#internal method Twig\\#'
		# TwigStan extends PHPStan, so it relies on its unstable API by design.
		-
			identifier: phpstanApi.class
			paths:
				- src/PHPStan/AnalysisResultToJson.php
				- src/PHPStan/Collector/MacroCollector.php
				- src/PHPStan/DynamicReturnType/TypeHintReturnType.php
				- src/PHPStan/GetAttributeCheck.php
		-
			identifier: phpstanApi.instanceofType
			paths:
				- src/PHPStan/AnalysisResultToJson.php
				- src/PHPStan/Collector/MacroCollector.php
				- src/PHPStan/DynamicReturnType/TypeHintReturnType.php
				- src/PHPStan/GetAttributeCheck.php
		-
			identifier: phpstanApi.method
			paths:
				- src/PHPStan/AnalysisResultToJson.php
				- src/PHPStan/Collector/MacroCollector.php
				- src/PHPStan/DynamicReturnType/TypeHintReturnType.php
				- src/PHPStan/GetAttributeCheck.php
		-
			identifier: phpstanApi.runtimeReflection
			paths:
				- src/PHPStan/AnalysisResultToJson.php
				- src/PHPStan/Collector/MacroCollector.php
				- src/PHPStan/DynamicReturnType/TypeHintReturnType.php
				- src/PHPStan/GetAttributeCheck.php
		-
			identifier: phpstanApi.new
			paths:
				- src/PHPStan/DynamicReturnType/Filter/SplitReturnType.php
				- src/PHPStan/DynamicReturnType/Function/CycleReturnType.php
				- src/PHPStan/DynamicReturnType/Function/RandomReturnType.php
		# Registered by the Symfony UX Twig component bundle in applications.
		-
			identifier: new.internalClass
			path: tests/twig-loader.php
		# The fixture exists to be read through Twig, so the property is never read in PHP.
		-
			identifier: property.onlyWritten
			path: tests/EndToEnd/GetAttribute/Fixtures/Account.php
		# The config files receive $config from the file that includes them.
		-
			identifier: twigstan.inlineVar
			path: tests/twigstan-*.php
	shipmonkRules:
		# Noisy for this codebase: closure parameter types are inferred, and exceptions in callables are not tracked.
		enforceClosureParamNativeTypehint:
			enabled: false
		forbidCheckedExceptionInCallable:
			enabled: false
		enforceReadonlyPublicProperty:
			enabled: false
		forbidVariableTypeOverwriting:
			enabled: false
	dynamicConstantNames:
		- Twig\Environment::MAJOR_VERSION
		- Twig\Environment::VERSION_ID
