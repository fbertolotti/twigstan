#!/usr/bin/env sh
# Runs Castor inside the development container, so nothing has to be installed on the host.
# Usage: bin/castor <task> [arguments]
set -eu

cd "$(dirname "$0")/.."

docker compose up -d --wait php >/dev/null 2>&1 || docker compose up -d --wait php

if [ -t 0 ] && [ -t 1 ]; then
    exec docker compose exec php castor "$@"
fi

exec docker compose exec -T php castor "$@"
